    <position class="small_actuator" name="pos_ankle_roll_r_joint" joint="ankle_roll_r_joint" ctrlrange="-0.523599 0.523599" group="0"/>

    <!-- 腰部关节驱动器 -->
    <position class="large_actuator" name="pos_waist_yaw_joint" joint="waist_yaw_joint" ctrlrange="-2.61799 3.22886" group="1"/>
    <position class="large_actuator" name="pos_waist_roll_joint" joint="waist_roll_joint" ctrlrange="-0.436332 0.436332" group="1"/>
    <position class="large_actuator" name="pos_waist_pitch_joint" joint="waist_pitch_joint" ctrlrange="-0.523599 0.872665" group="1"/>

